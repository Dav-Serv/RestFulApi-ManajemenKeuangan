{
  "info": {
    "name": "Expense Tracker API - Manajemen Keuangan Mahasiswa",
    "description": "Collection untuk testing REST API CRUD pemasukan/pengeluaran. OAuth Google sementara belum dipakai — gunakan endpoint 'Dev Login' untuk mendapatkan token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "transaction_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dev Login (sementara, tanpa Google)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token tersimpan otomatis ke variable {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/dev-login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mahasiswa@example.com\",\n  \"name\": \"Budi Santoso\"\n}"
            },
            "description": "Membuat/login user testing tanpa lewat Google. Token otomatis tersimpan ke variable collection {{token}} lewat script di tab Tests."
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "Google Login (buka manual di browser)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/google/login",
            "description": "Tidak bisa ditest lewat Postman langsung (perlu consent screen Google). Buka URL ini di browser."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('transaction_id', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"expense\",\n  \"category\": \"makan\",\n  \"amount\": 25000,\n  \"description\": \"makan siang warteg\",\n  \"date\": \"2026-08-31T12:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Create Transaction (income)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"income\",\n  \"category\": \"uang saku\",\n  \"amount\": 1000000,\n  \"description\": \"kiriman bulanan\",\n  \"date\": \"2026-08-01T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/transactions?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get All Transactions (filter expense bulan ini)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/transactions?type=expense&start_date=2026-08-01&end_date=2026-08-31",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "type", "value": "expense" },
                { "key": "start_date", "value": "2026-08-01" },
                { "key": "end_date", "value": "2026-08-31" }
              ]
            }
          }
        },
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/transactions/summary"
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/transactions/{{transaction_id}}"
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/transactions/{{transaction_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"expense\",\n  \"category\": \"makan\",\n  \"amount\": 30000,\n  \"description\": \"makan siang warteg (revisi harga)\"\n}"
            }
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/transactions/{{transaction_id}}"
          }
        }
      ]
    }
  ]
}
